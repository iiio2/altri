# Build context is the repo root (both images need workspace files). Keep it small and secret-free.
.git
.env
**/.env
**/node_modules
**/.next
**/*.tsbuildinfo
**/next-env.d.ts
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
.claude
.agents
# docs/ is git-ignored; only the seed file goes into the API image.
docs/*
!docs/seed.json
