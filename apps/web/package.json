{
  "name": "web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "cd ../api && uv run python -c 'import json; from altri_api.main import app; print(json.dumps(app.openapi(), indent=1))' > ../web/lib/api/openapi.json && cd ../web && pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9.3 openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2"
  }
}
