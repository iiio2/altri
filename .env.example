# Postgres connection (libpq URL; sslmode etc. are passed through)
DATABASE_URL=postgresql://user:password@localhost:5432/altri

# Optional. Tests default to DATABASE_URL's database name + "_test" and rebuild it every run.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/altri_test

# The app's "now" (UTC). Business logic never reads the system clock.
APP_NOW=2026-11-11T15:00:00Z
# ticking (default): APP_NOW + time since the API process started, so meeting timers run.
# frozen: exactly APP_NOW (tests and the rules report always use this).
APP_CLOCK=ticking

# Browser origins allowed to call the API with credentials, and to open the live WebSocket (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set true when served over HTTPS
SESSION_COOKIE_SECURE=false
